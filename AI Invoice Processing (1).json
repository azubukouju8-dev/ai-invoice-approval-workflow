        "url": "   https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=   {{ JSON.stringify({\n        model: 'openai/gpt-oss-120b',\n     response_format: { type: 'json_object' },\n     messages: [\n       { role: 'system', content: 'You extract invoice data. Return ONLY a JSON object with keys: vendor (string), invoice_number (string), invoice_date (YYYY-MM-DD), currency (3-letter code), total (number), line_items (array of objects with description, quantity, amount). Use null for any value that is missing.' },\n       { role: 'user', content: $json.text }\n     ]\n   }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
