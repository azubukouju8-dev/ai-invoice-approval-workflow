      ],
      "id": "fefb6280-1dc8-4a33-a785-e2dfb794e26b",
      "name": "HTTP Request",
      "credentials": {
        "httpBearerAuth": {
          "id": "JN2eOEJCDnDFQJVM",
          "name": "Bearer Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\n\nlet d;\ntry {\n  d = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  d = {};\n}\n\nconst issues = [];\n\n['vendor', 'invoice_number', 'invoice_date', 'total'].forEach(k => {\n  if (d[k] === undefined || d[k] === null || d[k] === '') issues.push('Missing ' + k);\n});\n\nif (d.total !== undefined && d.total !== null && !(Number(d.total) > 0)) {\n  issues.push('Total must be greater than 0');\n}\n\nif (d.invoice_date && !/^\\d{4}-\\d{2}-\\d{2}$/.test(d.invoice_date)) {\n  issues.push('Invalid date format');\n}\n\nconst items = Array.isArray(d.line_items) ? d.line_items : [];\n\nreturn [{\n  json: {\n    vendor: d.vendor,\n    invoice_number: d.invoice_number,\n    invoice_date: d.invoice_date,\n    currency: d.currency || 'USD',\n    total: Number(d.total),\n    line_items: JSON.stringify(items),\n    valid: issues.length === 0,\n    issues: issues.join('; ')\n  }\n}];"
      },
